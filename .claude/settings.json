{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/orient.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Reading repo state…"
          }
        ],
        "Notification": [
              {
                "matcher": "",
                "hooks": [{ "type": "command", "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'" }]
              }
            ]
      }
    ]
  }
}
