{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm run verify -- *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run graph)",
      "Bash(npm run agents:sync)",
      "Bash(npm run agents:sync -- --check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./graphify-out/graph.json)",
      "Read(./graphify-out/graph.html)",
      "Read(./src/graphify-out/**)",
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Read(./python/.venv/**)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/orient.sh",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Reading repo state…"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command 'Add-Type -AssemblyName System.Windows.Forms; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(5000, \"Claude Code\", \"Claude Code needs your attention\", \"Info\"); Start-Sleep -Seconds 6; $n.Dispose()'",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
