# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API. Use the publishable key (sb_publishable_...), not
# the secret/service_role key -- anything prefixed NEXT_PUBLIC_ is sent to the
# browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Origin used to build the Google OAuth redirect target.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
