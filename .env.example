# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API. Use the publishable key (sb_publishable_...), not
# the secret/service_role key -- anything prefixed NEXT_PUBLIC_ is sent to the
# browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Origin used to build the Google OAuth redirect target.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only market data key (finnhub.io) -- no NEXT_PUBLIC_ prefix. Used by
# src/app/core/services/finnhub.ts for the dashboard's live quotes and news.
FINNHUB_API_KEY=

# Alpaca market data (data.alpaca.markets) -- server-only, no NEXT_PUBLIC_
# prefix. Credentials come from a paper account created for Papaldo; they are
# sent as the APCA-API-KEY-ID / APCA-API-SECRET-KEY headers. Used as a pricing
# and history source only. The paper-trading account itself is never touched
# and no order is ever submitted to it -- every user's cash, holdings and
# order history live in Papaldo's own Supabase tables.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ExchangeRate-API v6 (exchangerate-api.com) -- server-only, no NEXT_PUBLIC_
# prefix. Powers the $ / PHP display toggle; balances stay in USD in the DB.
EXCHANGE_RATE_APIKEY=
