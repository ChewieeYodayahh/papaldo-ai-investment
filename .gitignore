# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# committed example env file
!.env.example

# ──────────────────────────────────────────────────────────────────────────
# SECRETS / CREDENTIALS — NEVER COMMIT THESE
# ──────────────────────────────────────────────────────────────────────────
# API keys (common patterns)
*api*key*.json
*api*key*.txt
*api*key*.env
*secret*.json
*secret*.txt
*secret*.env
*token*.json
*token*.txt
*token*.env
*.api-key
*.secret
*.token
*.key

# OmniRoute / Anthropic
.omniroute/
omniroute/
*omniroute*.key
*omniroute*.secret
*anthropic*key*

# Generic credential files
*.pem
*.ppk
*.p12
*.pfx
*.cer
*.crt
*.key
*.p8
*.p7b
*.p7c
*.der
*.csr

# Cloud provider credentials
aws-credentials*
gcp-credentials*
azure-credentials*
*_credentials.json
service-account*.json
*service-account*.json
credentials.json

# Database / connection strings
*.connection-string*
*.conn-string*
*.db-url*

# SSH / GPG
.ssh/
.gnupg/
*.gpg
*.asc
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# CI/CD secrets
.github/workflows/*.secret.yml
.gitlab-ci*.secret.yml

# Local settings (Claude Code settings.local.json can have env vars)
.claude/settings.local.json

# Temporary secret files
*.secret
*.secrets
secrets/
secret/
.tmp-secret*

# Vendored agent skills — symlinks into .agents/, not ours to commit
.agents/
.claude/skills/*
!.claude/skills/wrap/
!.claude/skills/provider-switch/
!.claude/skills/nextjs-project-structure/

# Generated knowledge graph (/graphify) — rebuildable, ~2MB
graphify-out/

# editor / agent-local config
.vscode/
.codex/
.claude/launch.json

# editor / agent-local config
.vscode/
.codex/
.claude/launch.json
